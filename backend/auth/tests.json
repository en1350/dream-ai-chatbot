{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Регистрация без согласия отклоняется",
      "method": "POST",
      "path": "/?action=register",
      "body": {"email": "test@example.com", "name": "Тест", "password": "secret123", "consent": false},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Регистрация с коротким паролем отклоняется",
      "method": "POST",
      "path": "/?action=register",
      "body": {"email": "test2@example.com", "name": "Тест", "password": "123", "consent": true},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Вход с неверными данными отклоняется",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "nobody-xyz@example.com", "password": "wrongpass"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Профиль без токена требует авторизацию",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Запрос сброса для несуществующего email возвращает успех (не раскрывает базу)",
      "method": "POST",
      "path": "/?action=forgot",
      "body": {"email": "nobody-xyz@example.com"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Запрос сброса с невалидным email отклоняется",
      "method": "POST",
      "path": "/?action=forgot",
      "body": {"email": "not-an-email"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Сброс с недействительным токеном отклоняется",
      "method": "POST",
      "path": "/?action=reset",
      "body": {"token": "nonexistent-token", "password": "newsecret123"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Сброс с коротким паролем отклоняется",
      "method": "POST",
      "path": "/?action=reset",
      "body": {"token": "any", "password": "123"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}