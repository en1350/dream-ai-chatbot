{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Список ботов без авторизации — 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "PUT без id и без авторизации — 401",
      "method": "PUT",
      "path": "/",
      "body": {"status": "active"},
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "PUT с неверным статусом без авторизации — 401",
      "method": "PUT",
      "path": "/",
      "body": {"id": 1, "status": "wrong"},
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "DELETE без id и без авторизации — 401",
      "method": "DELETE",
      "path": "/",
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    }
  ]
}
